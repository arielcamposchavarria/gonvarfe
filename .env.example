# URL base del backend real (gonvarbe), usado por los adaptadores HTTP de
# sitios, usuarios, roles y autenticación (src/infrastructure/http/).
GONVARBE_API_URL=http://localhost:3002

# Debe ser idéntico al JWT_SECRET configurado en gonvarbe/.env: el frontend
# verifica la firma del token localmente (ver src/lib/auth/session-cookie.ts).
JWT_SECRET=cambia-este-valor-por-un-secreto-largo-y-aleatorio
